+/* ------------------------------------------------------------------ the boot logo */
+
+/*
+ * The stock U-Boot draws the boot logo, leaves the display controller scanning it out, and says
+ * so in the FDT it passes in x0: the framebuffer as the reg of the "rockchip,drm-logo"
+ * reserved-memory node (nova_logo_range), and in each display route
+ * (/display-subsystem/route/<route>) the picture (logo,offset, logo,width, logo,height,
+ * logo,bpp, logo,ymirror), the timings it set (video,*) and the margins (overscan,*). The
+ * kernel's display driver reserves that memory, maps it for the display controller's IOMMU and
+ * takes the picture over. Without them the framebuffer is free memory to the kernel, the
+ * controller goes on scanning whatever the kernel puts there, and the panel shows that
+ * instead of the logo. This U-Boot boots the FIT's own DTB, so it carries them over:
+ * nova_logo_keep keeps the framebuffer out of U-Boot's own allocations (arch_setup_dest_addr
+ * keeps the relocated U-Boot below it), and nova_logo_handoff writes them into the kernel's
+ * FDT (ft_board_setup, for a NovaOS FIT only). A route's connection and status stay the
+ * booted DTB's own.
+ */
+static void *nova_logo_x0;	/* a copy of x0, when the logo on the panel is the stock U-Boot's */
+static bool nova_logo_now;	/* bootm of a NovaOS FIT: hand the logo over */
+
+static void nova_logo_keep(const void *x0)
+{
+	u64 base, size;
+
+	if (!x0 || nova_logo_range(x0, &base, &size)) {
+		nlog("logo: x0 names no boot logo (no drm-logo range): nothing to keep");
+		return;
+	}
+	nova_reserve(base, size, "boot logo");
+	nova_logo_x0 = malloc(fdt_totalsize(x0));
+	if (nova_logo_x0)
+		memcpy(nova_logo_x0, x0, fdt_totalsize(x0));
+	nlog("logo: the stock U-Boot's boot logo at %llx + %llx; U-Boot at %lx-%lx (%s)",
+	     (unsigned long long)base, (unsigned long long)size, gd->start_addr_sp - CONFIG_STACK_SIZE,
+	     gd->initial_relocaddr, base >= gd->initial_relocaddr ||
+	     base + size <= gd->start_addr_sp - CONFIG_STACK_SIZE ? "clear of it" : "OVER IT");
+}
+
+/* The properties of a route that stay the booted DTB's own. */
+static bool nova_logo_route_own(const char *name)
+{
+	return !strcmp(name, "phandle") || !strcmp(name, "linux,phandle") ||
+	       !strcmp(name, "connect") || !strcmp(name, "status");
+}
+
+/* /display-subsystem/route/<name> (or the route node itself, name NULL), or a negative error. */
+static int nova_route_node(const void *fdt, const char *name)
+{
+	int node = fdt_path_offset(fdt, "/display-subsystem");
+
+	if (node < 0 || fdt_node_check_compatible(fdt, node, "rockchip,display-subsystem"))
+		node = fdt_node_offset_by_compatible(fdt, -1, "rockchip,display-subsystem");
+	if (node >= 0)
+		node = fdt_subnode_offset(fdt, node, "route");
+	if (node >= 0 && name)
+		node = fdt_subnode_offset(fdt, node, name);
+	return node;
+}
+
+/* Into the kernel's FDT: the logo's framebuffer and each route's picture, as x0 has them. */
+static void nova_logo_handoff(void *blob)
+{
+	const void *x0 = nova_logo_x0, *val, *old;
+	const char *route, *name;
+	int node, parent, ac = 0, sc = 0, k = 0, c, p, len, olen, ret, n = 0, kroute;
+	u64 t0 = nova_us();
+	fdt32_t reg[4];
+	u64 base, size;
+
+	if (!x0 || nova_logo_range(x0, &base, &size))
+		return;
+	node = nova_logo_node(blob, &parent);
+	if (node >= 0) {
+		ac = fdt_address_cells(blob, parent);
+		sc = fdt_size_cells(blob, parent);
+	}
+	if (ac < 1 || ac > 2 || sc < 1 || sc > 2) {
+		nlog("logo: the kernel's FDT has no drm-logo node to take it: not handed over");
+		return;
+	}
+	if (ac == 2)
+		reg[k++] = cpu_to_fdt32(base >> 32);
+	reg[k++] = cpu_to_fdt32(base);
+	if (sc == 2)
+		reg[k++] = cpu_to_fdt32(size >> 32);
+	reg[k++] = cpu_to_fdt32(size);
+	ret = fdt_setprop(blob, node, "reg", reg, k * sizeof(*reg));
+	if (ret) {
+		nlog("logo: drm-logo reg: %d: not handed over", ret);
+		return;
+	}
+	/*
+	 * A setprop moves only what follows the node it writes: the route parent (looked up after the
+	 * reg above, once) and the route being written keep their offsets, and each route is looked up
+	 * among the parent's few children. Any lookup from the root walks the tree up to the node, as
+	 * long as a scan of all of it: once per property, that was 60 ms of every boot.
+	 */
+	kroute = nova_route_node(blob, NULL);
+	if (kroute < 0) {
+		nlog("logo: the kernel's FDT has no display route node: only the drm-logo reg handed over");
+		return;
+	}
+	c = nova_route_node(x0, NULL);
+	if (c >= 0)
+		c = fdt_first_subnode(x0, c);
+	for (; c >= 0; c = fdt_next_subnode(x0, c)) {
+		route = fdt_get_name(x0, c, NULL);
+		node = route ? fdt_subnode_offset(blob, kroute, route) : -1;
+		if (node < 0)
+			continue;
+		fdt_for_each_property_offset(p, x0, c) {
+			val = fdt_getprop_by_offset(x0, p, &name, &len);
+			if (!val || nova_logo_route_own(name))
+				continue;
+			old = fdt_getprop(blob, node, name, &olen);
+			if (old && olen == len && !memcmp(old, val, len))
+				continue;
+			ret = fdt_setprop(blob, node, name, val, len);
+			if (ret) {
+				nlog("logo: %s %s: %d", route, name, ret);
+				return;
+			}
+			n++;
+		}
+	}
+	nlog("logo: handed to the kernel: drm-logo %llx + %llx, %d route properties as x0 has them, in %lluus",
+	     (unsigned long long)base, (unsigned long long)size, n, (unsigned long long)(nova_us() - t0));
+}
+
+/* No boot logo on the panel (this U-Boot was kexec'd): the FDT for the next U-Boot names none. */
+static void nova_logo_forget(void *fdt)
+{
+	static const u8 zero[16];
+	int parent, node = nova_logo_node(fdt, &parent), len;
+
+	if (node >= 0 && fdt_getprop(fdt, node, "reg", &len) && len <= (int)sizeof(zero))
+		fdt_setprop_inplace(fdt, node, "reg", zero, len);
+}
+
 /* The watchdog counts: armed at entry, and its counter moves. */
 static bool nova_wdog_check(void)
 {
@@ -1310,7 +1501,9 @@ static void nova_bootm(void *fit, const char *line)
 	snprintf(cmd, sizeof(cmd), "bootm %lx#%s", (ulong)map_to_sysmem(fit), CONFIG_NOVA_FIT_CONFIG);
 	nlog("%s (%zu-byte command line)", cmd, strlen(line));
 	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "nova_bootm");
+	nova_logo_now = true;
 	run_command(cmd, 0);
+	nova_logo_now = false;
 	nlog("bootm returned");
 }
 
@@ -1346,6 +1539,8 @@ static void nova_chainload(const struct nova_img *x, const char *line)
 		nlog("%s: cannot write /chosen for its U-Boot", x->name);
 		return;
 	}
+	if (nova_kexec_entry)
+		nova_logo_forget(fdt);
 	env_set("bootargs", line);
 	pmsg_console();
 	snprintf(cmd, sizeof(cmd), "booti %lx - %lx", kaddr, faddr);
@@ -1661,6 +1856,8 @@ int ft_board_setup(void *blob, struct bd_info *bd)
 	int i, ret = 0;
 
 	pmsg_console();
+	if (nova_logo_now)
+		nova_logo_handoff(blob);
 	for (i = 0; i < nova_lpi.count && !ret; i++) {
 		u8 *p = map_sysmem(nova_lpi.pend[i], LPI_PENDBASE_SZ);
 		ulong n = 0, j;
@@ -1952,6 +2149,7 @@ static int do_boot(void)
 	}
 	nova_x0_line = nova_strdup(line);
 	nlog("x0: %s, its command line %zu bytes", x0 ? "an FDT" : "no FDT", line ? strlen(line) : 0);
+	nova_logo_keep(x0);
 	desc = nova_card();
 	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "nova_mmc_ready");
 	if (chain_lba) {
