#
# Every input of the open first stage for the Rigol DHO800/DHO900 and MHO900 (RK3399), by commit or sha256:
# TPL + SPL + U-Boot proper from U-Boot, BL31 from TF-A, both built from source. build.sh refuses any input that
# is not these bytes.

# --- U-Boot v2026.10 + patches/0001-0017 ---
UBOOT_REPO="https://source.denx.de/u-boot/u-boot.git"
UBOOT_TAG="v2026.10"
UBOOT_REF="5508406582f6f7120dce0c4b3059819a41788db2"
# One defconfig per family (patches/0002).
FAMILIES="dho900 mho900"

# --- TF-A v2.15.0, PLAT=rk3399 bl31 with the Cortex-M0 PMU firmware built from source ---
TFA_REPO="https://github.com/ARM-software/arm-trusted-firmware.git"
TFA_TAG="v2.15.0"
TFA_REF="da738d5eae93af342fdc4995dd3c05acb4c9d757"
# 10 = errors only (at 115200 baud every character costs 87 us). No SPD (no OP-TEE), no PLAT_RK_DP_HDCP (it needs
# a vendor hdcp.bin).
TFA_LOG_LEVEL="10"

# --- Compilers: Arm GNU Toolchain 14.2.Rel1, x86_64 Linux hosted (published 2024-12) ---
# sha256 from Arm's own .sha256asc beside each tarball. Pinned tarballs rather than the host's distribution
# compilers, so every host builds the same bytes.
ARM_TC_BASE="https://developer.arm.com/-/media/Files/downloads/gnu/14.2.rel1/binrel"
AARCH64_TC="arm-gnu-toolchain-14.2.rel1-x86_64-aarch64-none-elf"
AARCH64_TC_SHA256="eb54c4727440d03199a6af9a6d021e77f45410cad39effce4e5a1c10a88b7f04"
M0_TC="arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi"
M0_TC_SHA256="62a63b981fe391a9cbad7ef51b17e49aeaa3e7b0d029b36ca1e9c3b2a9b78823"

# --- Python helpers for binman (pyelftools) and pylibfdt (SWIG): PyPI wheels ---
PYELFTOOLS_WHEEL="https://files.pythonhosted.org/packages/46/2a/f9697576603dae937727827505a6126a066affb227034e77e6f9068910da/pyelftools-0.33-py3-none-any.whl"
PYELFTOOLS_SHA256="f215ad5f47d3f1373a21496a6c9e0707c622840d0622f23ff7ce08678b020036"
SWIG_WHEEL="https://files.pythonhosted.org/packages/29/85/f5f7976ea09a4a16eee5b96f7d7c289685b19651c51ce9946128f1315440/swig-4.5.0-py3-none-manylinux_2_12_x86_64.manylinux2010_x86_64.whl"
SWIG_SHA256="4821eb0b69869af25547fcd00c8235e274e43515d001fd32cf079d52eb7d1d99"

# --- rkdeveloptool (GPL-2.0): its own loader parser checks the Maskrom loader file tools/mkloader.py writes
# (the build compiles RKImage.cpp, RKBoot.cpp and crc.cpp only; nothing talks to USB) ---
RKDEVELOPTOOL_REPO="https://github.com/rockchip-linux/rkdeveloptool.git"
RKDEVELOPTOOL_REF="304f073752fd25c854e1bcf05d8e7f925b1f4e14"

# --- The card: idbloader at LBA 64, inside the scope's own IDB area (LBA 64-535); u-boot.itb at LBA 2048, in the
# gap before the vendor storage at LBA 7168, which is all zero on the scope's card. The card gate checks that both fit;
# nothing here writes a card. ---
IDB_LBA="64"
IDB_END_LBA="536"
ITB_LBA="2048"
GAP_END_LBA="7168"
