# What this release's boot chain was built from and with; build.sh reads it. Each tree in src/ is the
# upstream commit named here with the listed patches applied (src/UPSTREAM.sha256: the files left as
# upstream has them).
# src/u-boot-first-stage: u-boot v2026.10, https://source.denx.de/u-boot/u-boot.git commit 5508406582f6f7120dce0c4b3059819a41788db2 (tree c54aa18f1c43c1b8b292434cc74cdc11e002f851), with 0001-rockchip-an-option-for-a-Linux-arm64-Image-header-on.patch 0002-rockchip-rk3399-Rigol-DHO800-DHO900-and-MHO900-the-N.patch 0003-clk-rockchip-rk3399-SD-SDIO-and-eMMC-clocks-from-the.patch 0004-lib-lz4-inline-the-decoder-s-fixed-size-copies-unali.patch 0005-rockchip-rk3399-nova-the-MMU-and-the-caches-on-befor.patch 0006-rockchip-rk3399-nova-keep-the-stock-U-Boot-s-boot-lo.patch 0007-lib-string-memmove-copies-backward-a-word-at-a-time.patch 0008-rockchip-rk3399-nova-the-stock-rung-boots-the-stock-f.patch 0009-board_f-Make-printing-reset-information-optional.patch 0010-rockchip-boot_mode-an-option-for-a-board-without-a-d.patch 0011-rockchip-rk3399-nova-Step-2-our-own-TPL-SPL-and-BL31.patch 0012-mmc-dw_mmc-poll-the-FIFO-every-microsecond-not-every.patch 0013-rockchip-rk3399-the-LPDDR4-at-856-MHz-the-scope-s-ow.patch 0014-rockchip-rk3399-a-test-option-the-LPDDR4-left-at-its.patch 0015-rockchip-bootrom-a-stage-loaded-over-USB-does-not-go.patch 0016-rockchip-rk3399-nova-a-test-option-TPL-s-LPDDR4-init.patch 0017-rockchip-rk3399-an-option-the-LPDDR4-refresh-timings.patch 0018-rockchip-rk3399-options-two-differences-from-Rockchip.patch 0019-rockchip-rk3399-the-LPDDR4-timing-set-of-the-Rigol-b.patch
# src/tf-a-v2.15.0: tf-a v2.15.0, https://github.com/ARM-software/arm-trusted-firmware.git commit da738d5eae93af342fdc4995dd3c05acb4c9d757 (tree 9b8ab09105e08b5d3593813ec1442e28720e3c00), as published
UBOOT_TAG=v2026.10
UBOOT_COMMIT=5508406582f6f7120dce0c4b3059819a41788db2
TFA_TAG=v2.15.0
TFA_COMMIT=da738d5eae93af342fdc4995dd3c05acb4c9d757
# the U-Boot commit's date: every timestamp in the binaries
SOURCE_DATE_EPOCH=1791236133
LANES="first-stage"
# first-stage: Arm GNU Toolchain tarballs (BUILDING.txt), TF-A at LOG_LEVEL errors only
FIRST_STAGE_UBOOT=u-boot-first-stage
FIRST_STAGE_TFA=tf-a-v2.15.0
FIRST_STAGE_BUILD_ID=7e3450e11aa6
FIRST_STAGE_FAMILIES="dho900 mho900"
FIRST_STAGE_TFA_LOG_LEVEL=10
FIRST_STAGE_AARCH64_TC=arm-gnu-toolchain-14.2.rel1-x86_64-aarch64-none-elf
FIRST_STAGE_M0_TC=arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi
FIRST_STAGE_CC="aarch64-none-elf-gcc (Arm GNU Toolchain 14.2.Rel1 (Build arm-14.52)) 14.2.1 20241119"
FIRST_STAGE_M0_CC="arm-none-eabi-gcc (Arm GNU Toolchain 14.2.Rel1 (Build arm-14.52)) 14.2.1 20241119"
# the build's options besides the defaults, merged over the defconfig like the build id
FIRST_STAGE_VARIANT_dho900="CONFIG_NOVA_RK3399_DDR_RIGOL=y"
FIRST_STAGE_VARIANT_mho900="CONFIG_NOVA_RK3399_DDR_RIGOL=y"
