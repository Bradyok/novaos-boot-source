index 00000000..389beff3
--- /dev/null
+++ b/board/rigol/nova_rk3399/nova_stock.c
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Rigol DHO800/DHO900 and MHO900 (RK3399): what the scope's systems expect of their loader
+ * (nova_stock.h).
+ *
+ * Copyright (C) 2026 Olympian LED, Inc.
+ */
+
+#ifdef __UBOOT__
+#include <linux/string.h>
+#else
+#include <string.h>
+#endif
+#include "nova_stock.h"
+
+#ifndef ARRAY_SIZE
+#define ARRAY_SIZE(a)	(sizeof(a) / sizeof((a)[0]))
+#endif
+
+enum nova_flag_mode nova_flag_mode(u32 v)
+{
+	if (v == NOVA_FLAG_LOADER_ERROR)
+		return NOVA_FLAG_LOADER;
+	/* the consumed form 0xc35242xx, zero, and anything unknown: normal */
+	if ((v & ~0xffu) != NOVA_FLAG_REBOOT)
+		return NOVA_FLAG_NORMAL;
+	switch (v & 0xffu) {
+	case 0x01:
+		return NOVA_FLAG_LOADER;
+	case 0x03:
+		return NOVA_FLAG_RECOVERY;
+	default:
+		return NOVA_FLAG_NORMAL;
+	}
+}
+
+const char *nova_flag_mode_name(enum nova_flag_mode mode)
+{
+	static const char *const names[] = { "normal", "loader", "recovery" };
+
+	return (unsigned int)mode < ARRAY_SIZE(names) ? names[mode] : "?";
+}
+
+/* Front-panel frames: FA b1 b2 crc AF, crc the CRC-7/MMC of b1 and b2. */
+const u8 nova_frame_runstop_press[5] = { 0xfa, 0x08, 0x0c, 0x34, 0xaf };
+const u8 nova_frame_runstop_release[5] = { 0xfa, 0x08, 0x00, 0x58, 0xaf };
+const u8 nova_frame_power_mode_auto[5] = { 0xfa, 0x05, 0x05, 0x0a, 0xaf };
+
+bool nova_rx_runstop(struct nova_rx *rx, u8 byte)
+{
+	memmove(rx->w, rx->w + 1, sizeof(rx->w) - 1);
+	rx->w[sizeof(rx->w) - 1] = byte;
+	if (rx->n < sizeof(rx->w))
+		rx->n++;
+	return rx->n == sizeof(rx->w) &&
+	       (!memcmp(rx->w, nova_frame_runstop_press, sizeof(rx->w)) ||
+		!memcmp(rx->w, nova_frame_runstop_release, sizeof(rx->w)));
+}
+
+u64 nova_runstop_wait_us(bool known, u64 opened_us, u64 now_us, u32 window_ms)
+{
+	u64 window = (u64)window_ms * 1000;
+
+	if (!known || now_us < opened_us)
+		return window;
+	return now_us - opened_us >= window ? 0 : window - (now_us - opened_us);
+}
+
+bool nova_bcb_says_recovery(const u8 *msg, size_t n)
+{
+	static const char cmd[] = "boot-recovery";
+
+	/* the command field is 32 bytes, the text NUL-terminated within them */
+	return n >= 32 && !memcmp(msg, cmd, sizeof(cmd));
+}
+
+int nova_stock_order(enum nova_flag_mode mode, enum nova_part *out)
+{
+	int n = 0;
+
+	switch (mode) {
+	case NOVA_FLAG_NORMAL:
+		out[n++] = NOVA_PART_BOOT;
+		/* fall through */
+	case NOVA_FLAG_RECOVERY:
+		out[n++] = NOVA_PART_RECOVERY;
+		out[n++] = NOVA_PART_BACKUP;
+		break;
+	case NOVA_FLAG_LOADER:
+		break;
+	}
+	return n;
+}
+
+const char *nova_part_name(enum nova_part part)
+{
+	static const char *const names[] = { "boot", "recovery", "backup" };
+
+	return (unsigned int)part < ARRAY_SIZE(names) ? names[part] : "?";
+}
+
+int nova_parm_recovery(const char *parm, char *out, size_t outlen)
+{
+	static const char key[] = "mtdparts=rk29xxnand:";
+	static const char first[] = "0x00002000@0x00000000(parameter),";
+	const char *at = strstr(parm, key);
+	size_t head, len = strlen(parm);
+
+	if (!at) {
+		if (len + 1 > outlen)
+			return -1;
+		memcpy(out, parm, len + 1);
+		return (int)len;
+	}
+	head = at - parm + sizeof(key) - 1;
+	if (len + sizeof(first) > outlen)
+		return -1;
+	memcpy(out, parm, head);
+	memcpy(out + head, first, sizeof(first) - 1);
+	memcpy(out + head + sizeof(first) - 1, parm + head, len - head + 1);
+	return (int)(len + sizeof(first) - 1);
+}
