  * SoC code does. relocate_code already copes with the caches on (it cleans the copy to the point of
@@ -749,6 +761,11 @@ static void nova_caches_report(void)
 
 /* What OS_REG1 held when this U-Boot started (before anything here wrote it). */
 static u32 nova_os_reg1_at_entry __section(".data");
