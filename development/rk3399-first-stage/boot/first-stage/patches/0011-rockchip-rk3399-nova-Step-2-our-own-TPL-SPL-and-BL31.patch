diff --git a/board/rigol/nova_rk3399/nova-mainline.config b/board/rigol/nova_rk3399/nova-mainline.config
new file mode 100644
index 00000000..94824358
--- /dev/null
+++ b/board/rigol/nova_rk3399/nova-mainline.config
@@ -0,0 +1,71 @@
+# Copyright (C) 2026 Olympian LED, Inc.
+# Step 2, the card's whole chain from source (TPL, SPL, TF-A BL31 and this U-Boot proper): merged over a
+# nova-*-rk3399_defconfig. `make` builds idbloader.img (TPL + SPL), u-boot.itb (U-Boot proper, BL31, the
+# control DT), u-boot-rockchip.bin and the Maskrom images u-boot-rockchip-usb471.bin / -usb472.bin.
+# CONFIG_NOVA_RK3399_KEXEC_TEST is not set
+# CONFIG_NOVA_RK3399_CHAINLOAD is not set
+CONFIG_NOVA_RK3399_MAINLINE=y
+CONFIG_BOOTCOMMAND="nova boot"
+CONFIG_CC_OPTIMIZE_LIBS_FOR_SPEED=y
+# the reboot flag and the attempt record read in board_early_init_f, before anything can write them
+CONFIG_BOARD_EARLY_INIT_F=y
+# Room in the kernel's FDT for /bootstage (ft_board_setup_ex grows the tree into it).
+CONFIG_SYS_FDT_PAD=0x8000
+CONFIG_TEXT_BASE=0x00200000
+# x0 from BL31 is no FDT (the family defconfig's default flavor selected this, and a visible symbol keeps its value)
+# CONFIG_SAVE_PREV_BL_FDT_ADDR is not set
+# TPL: the LPDDR4 init (rk3399-sdram-lpddr4-100.dtsi; rank, column, bank and row detected), no rkbin blob
+CONFIG_TPL=y
+CONFIG_RAM_ROCKCHIP_LPDDR4=y
+# CONFIG_RAM_ROCKCHIP_DEBUG is not set
+# TPL honors BOOT_BROM_DOWNLOAD in PMUGRF OS_REG0 (back to the BootROM's download mode); U-Boot proper never
+# writes it (no download key)
+CONFIG_ROCKCHIP_BOOT_MODE_REG=0xff320300
+# CONFIG_ROCKCHIP_DOWNLOAD_KEY is not set
+# SPL: u-boot.itb at card LBA 2048, in the zero gap LBA 533-7167, never the default 0x4000 (the uboot partition)
+CONFIG_SPL_MAX_SIZE=0x40000
+CONFIG_SPL_PAD_TO=0xf8000
+# CONFIG_SPL_RAW_IMAGE_SUPPORT is not set
+CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_USE_SECTOR=y
+CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x800
+CONFIG_SPL_OF_CONTROL=y
+CONFIG_OF_SPL_REMOVE_PROPS="clock-names interrupt-parent assigned-clocks assigned-clock-rates assigned-clock-parents"
+# BL31 gets the FDT, and with it the console's 115200 from /chosen/stdout-path
+# CONFIG_SPL_ATF_NO_PLATFORM_PARAM is not set
+CONFIG_ROCKCHIP_MASKROM_IMAGE=y
+# quiet: no banners, no DRAM report (TPL_/SPL_SILENT_CONSOLE follow SILENT_CONSOLE); U-Boot proper's own
+# output goes to its console record and the pmsg zone (silent=1). TPL keeps its error lines on UART2 through the
+# debug UART (it has no other console): a failed LPDDR4 training must say so.
+CONFIG_DEBUG_UART=y
+CONFIG_DEBUG_UART_BASE=0xFF1A0000
+CONFIG_DEBUG_UART_CLOCK=24000000
+CONFIG_DEBUG_UART_SHIFT=2
+# CONFIG_DEBUG_UART_ANNOUNCE is not set
+# CONFIG_SPL_BANNER_PRINT is not set
+# CONFIG_TPL_BANNER_PRINT is not set
+# CONFIG_SPL_DISPLAY_PRINT is not set
+# Loader mode: Rockusb on OTG0, the rear USB device port (the stock Loader's job)
+CONFIG_CMD_ROCKUSB=y
+CONFIG_USB=y
+CONFIG_USB_DWC3=y
+CONFIG_USB_DWC3_GENERIC=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_GADGET_DOWNLOAD=y
+CONFIG_USB_FUNCTION_ROCKUSB=y
+# CONFIG_USB_FUNCTION_FASTBOOT is not set
+CONFIG_PHY_ROCKCHIP_INNO_USB2=y
+CONFIG_DM_RESET=y
+# Resets by the CRU in every phase: TPL and SPL run before BL31, so the sysreset driver cannot be PSCI's (U-Boot
+# proper's own nova reset still asks BL31 by PSCI first, as in Step 1)
+# CONFIG_SYSRESET_PSCI is not set
+CONFIG_MMC_WRITE=y
+# every stage timed: TPL's and SPL's records stashed and taken over by U-Boot proper, which puts them all in
+# the kernel's /bootstage
+CONFIG_TPL_BOOTSTAGE=y
+CONFIG_SPL_BOOTSTAGE=y
+CONFIG_TPL_BOOTSTAGE_RECORD_COUNT=5
+CONFIG_SPL_BOOTSTAGE_RECORD_COUNT=10
+CONFIG_BOOTSTAGE_RECORD_COUNT=50
+CONFIG_BOOTSTAGE_STASH=y
+CONFIG_BOOTSTAGE_STASH_ADDR=0x1f0000
+CONFIG_BOOTSTAGE_STASH_SIZE=0x1000
