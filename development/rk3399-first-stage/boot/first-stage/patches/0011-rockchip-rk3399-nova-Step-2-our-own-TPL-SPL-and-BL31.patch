new file mode 100644
index 00000000..5c383ac8
--- /dev/null
+++ b/board/rigol/nova_rk3399/nova_stock.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Rigol DHO800/DHO900 and MHO900 (RK3399): what the scope's systems expect of the loader that
+ * starts them, as pure logic with no hardware access, for the U-Boot proper that SPL loads from the
+ * card (NOVA_RK3399_MAINLINE): the reboot flag, the front-panel controller's frames, the misc
+ * message, the order the stock boot partitions are tried in, and the partition table's command
+ * line on a recovery boot. board/rigol/nova_rk3399/nova_rk3399.c does the reads and writes; a host
+ * program builds this file alone to test it.
+ *
+ * Copyright (C) 2026 Olympian LED, Inc.
+ *
+ * THE REBOOT FLAG: PMUGRF OS_REG0 holds 0x5242c3xx after a Linux reboot that names a mode (the
+ * kernel's reboot-mode node writes it), or 0x1888aaff after an interrupted Rockusb sector write.
+ *
+ *   low byte 1 (mode-loader, mode-bootloader)  Loader (Rockusb), no timeout
+ *   low byte 3 (mode-recovery)                 boot `recovery` first
+ *   0x1888aaff (loader error)                  Loader
+ *   anything else                              a normal boot
+ *
+ * Low bytes 6 and 7 ask the stock firmware for a data wipe (its recovery with --wipe_data). This
+ * loader never acts on them: they are a normal boot, and nothing here writes misc.
+ */
+#ifndef __NOVA_STOCK_H
+#define __NOVA_STOCK_H
+
+#ifdef __UBOOT__
+#include <linux/types.h>
+#else
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+typedef uint8_t u8;
+typedef uint32_t u32;
+typedef uint64_t u64;
+#endif
+
+#define NOVA_FLAG_REBOOT	0x5242c300u
+#define NOVA_FLAG_LOADER_ERROR	0x1888aaffu
+
+enum nova_flag_mode {
+	NOVA_FLAG_NORMAL,
+	NOVA_FLAG_LOADER,
+	NOVA_FLAG_RECOVERY,
+};
+
+/* What the reboot flag in OS_REG0 asks for (the table above). */
+enum nova_flag_mode nova_flag_mode(u32 os_reg0);
+const char *nova_flag_mode_name(enum nova_flag_mode mode);
+
+/*
+ * The front-panel controller on UART0 (1,500,000 baud, 8N1): frames FA b1 b2 crc AF, crc the
+ * CRC-7/MMC of b1 and b2. Run/Stop pressed or released (slot 8, key 0x0c or 0x00) at power-on
+ * enters Loader mode; on every other normal boot the loader tells the controller the power-on
+ * mode (auto: no vendor setting for manual is read here).
+ */
+extern const u8 nova_frame_runstop_press[5];
+extern const u8 nova_frame_runstop_release[5];
+extern const u8 nova_frame_power_mode_auto[5];
+
+/* The last five bytes received: a window over the stream, any alignment. */
+struct nova_rx {
+	u8 w[5];
+	u8 n;
+};
+
+/* One byte more of the stream: true when the last five are a Run/Stop press or release. */
+bool nova_rx_runstop(struct nova_rx *rx, u8 byte);
+
+/*
+ * How much longer to listen for Run/Stop, in us: the window runs from when SPL opened UART0
+ * (opened_us on the boot counter, `known` false when SPL left no record of it) to opened_us +
+ * window_ms. A counter that reads less now than at the open (restarted in between) counts as
+ * unknown. Unknown: the whole window, from now.
+ */
+u64 nova_runstop_wait_us(bool known, u64 opened_us, u64 now_us, u32 window_ms);
+
+/*
+ * The misc partition's bootloader message, read at misc + 16 KiB only (its first 32 bytes, the
+ * command): true when it is boot-recovery. Offset 0 is never read.
+ */
+bool nova_bcb_says_recovery(const u8 *msg, size_t n);
+
+/* The stock boot partitions, in the order the reboot flag's mode tries them (then Loader). */
+enum nova_part {
+	NOVA_PART_BOOT,
+	NOVA_PART_RECOVERY,
+	NOVA_PART_BACKUP,
+};
+
+/* The partitions `mode` tries, in order, into `out` (room for 3); their number. */
+int nova_stock_order(enum nova_flag_mode mode, enum nova_part *out);
+const char *nova_part_name(enum nova_part part);
+
+/*
+ * The partition table's command line as the stock loader passes it on a boot of `recovery`: the
+ * parameter partition first in its mtdparts list. Its length, or -1 when it does not fit.
+ */
+int nova_parm_recovery(const char *parm, char *out, size_t outlen);
+
+#endif
diff --git a/board/rigol/nova_rk3399/nova_uart0.c b/board/rigol/nova_rk3399/nova_uart0.c
new file mode 100644
index 00000000..64cab291
--- /dev/null
+++ b/board/rigol/nova_rk3399/nova_uart0.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Rigol DHO800/DHO900 and MHO900 (RK3399): UART0 to the front-panel controller (nova_uart0.h).
+ *
+ * Copyright (C) 2026 Olympian LED, Inc.
+ *
+ * Its pins are GPIO2_C0/C1 only: GPIO2_C2 (UART0 CTS) is PCIe PERST# on the DHO and the AFG receive
+ * line on a rev-1 MHO, and is never touched. The controller's frames and baud rate are its own
+ * interface.
+ */
+
+#include <bootstage.h>
+#include <cpu_func.h>
+#include <mapmem.h>
+#include <time.h>
+#include <asm/cache.h>
+#include <asm/io.h>
+#include <asm/arch-rockchip/cru_rk3399.h>
+#include <asm/arch-rockchip/grf_rk3399.h>
+#include <asm/arch-rockchip/hardware.h>
+#include <linux/delay.h>
+#include <linux/string.h>
+#include "nova_uart0.h"
+
+/* Register blocks (rk3399-base.dtsi; GRF as in mach-rockchip/rk3399/rk3399.c). */
+#define RK3399_CRU_BASE		0xff760000
+#define RK3399_GRF_BASE		0xff770000
+#define NOVA_UART0_BASE		0xff180000	/* uart0: serial@ff180000 */
+
+/*
+ * DesignWare APB UART, 32-bit registers (reg-shift 2). SRR (0x88) and SFE (0x98) are DesignWare
+ * additions to the 16550 set: SRR resets the UART and its FIFOs, SFE turns the FIFOs on.
+ */
+#define UART_RBR		0x00
+#define UART_THR		0x00
+#define UART_DLL		0x00
+#define UART_DLH		0x04
+#define UART_IER		0x04
+#define UART_LCR		0x0c
+#define UART_LSR		0x14
+#define UART_SRR		0x88
+#define UART_SFE		0x98
+
+#define UART_LCR_8N1		0x03
+#define UART_LCR_DLAB		0x80
+#define UART_LSR_DR		0x01
+#define UART_LSR_THRE		0x20
+#define UART_LSR_TEMT		0x40
+#define UART_SRR_ALL		0x07	/* UART, receive FIFO and transmit FIFO reset */
+
+/*
+ * CRU, as Linux's drivers/clk/rockchip/clk-rk3399.c describes it: clk_uart0 is a mux in
+ * CLKSEL_CON33 bits [9:8] of {clk_uart0_div, clk_uart0_frac, xin24m}; pclk_uart0's gate is
+ * CLKGATE_CON22 bit 0.
+ */
+#define CRU_UART0_SEL_SHIFT	8
+#define CRU_UART0_SEL_MASK	(3 << CRU_UART0_SEL_SHIFT)
+#define CRU_UART0_SEL_XIN24M	(2 << CRU_UART0_SEL_SHIFT)
+#define CRU_PCLK_UART0_GATE	(1 << 0)
+
+/* 24 MHz / (16 x 1,500,000) = 1: the front-panel controller's 1,500,000 baud. */
+#define UART0_DIVISOR		1
+
+/* What SPL leaves for U-Boot proper at CONFIG_NOVA_SPL_HANDOFF_ADDR: when it opened UART0. */
+#define NOVA_HANDOFF_MAGIC	0x304f554eu	/* "NUO0" */
+
+struct nova_handoff {
+	u32 magic;
+	u32 check;		/* ~magic ^ the two halves of `us` */
+	u64 us;			/* the boot counter (timer_get_boot_us()) at the open */
+};
+
+static u32 nova_handoff_check(u64 us)
+{
+	return ~NOVA_HANDOFF_MAGIC ^ (u32)us ^ (u32)(us >> 32);
+}
+
+void nova_uart0_open(void)
+{
+	struct rockchip_cru *cru = (void *)RK3399_CRU_BASE;
+	struct rk3399_grf_regs *grf = (void *)RK3399_GRF_BASE;
+	void __iomem *uart = (void __iomem *)NOVA_UART0_BASE;
+
+	rk_clrsetreg(&cru->clksel_con[33], CRU_UART0_SEL_MASK, CRU_UART0_SEL_XIN24M);
+	rk_clrreg(&cru->clkgate_con[22], CRU_PCLK_UART0_GATE);
+	rk_clrsetreg(&grf->gpio2c_iomux,
+		     GRF_GPIO2C0_SEL_MASK | GRF_GPIO2C1_SEL_MASK,
+		     GRF_UART0BT_SIN << GRF_GPIO2C0_SEL_SHIFT |
+		     GRF_UART0BT_SOUT << GRF_GPIO2C1_SEL_SHIFT);
+
+	writel(UART_SRR_ALL, uart + UART_SRR);
+	udelay(10);
+	writel(0, uart + UART_IER);
+	writel(UART_LCR_DLAB | UART_LCR_8N1, uart + UART_LCR);
+	writel(UART0_DIVISOR & 0xff, uart + UART_DLL);
+	writel(UART0_DIVISOR >> 8, uart + UART_DLH);
+	writel(UART_LCR_8N1, uart + UART_LCR);
+	writel(1, uart + UART_SFE);	/* FIFOs on */
+}
+
+#if defined(CONFIG_XPL_BUILD)
+#if !defined(CONFIG_TPL_BUILD)
+/*
+ * Called by spl_board_init() (mach-rockchip/rk3399/rk3399.c), in SPL only, before it loads U-Boot
+ * proper: UART0 opened, and the moment recorded for U-Boot proper's Run/Stop window. SPL cleans
+ * the D-cache before it leaves for BL31.
+ */
+void led_setup(void)
+{
+	struct nova_handoff *h = (void *)CONFIG_NOVA_SPL_HANDOFF_ADDR;
+	u64 us;
+
+	nova_uart0_open();
+	us = timer_get_boot_us();
+	h->us = us;
+	h->check = nova_handoff_check(us);
+	h->magic = NOVA_HANDOFF_MAGIC;
+}
+#endif
+#else /* U-Boot proper */
+
+bool nova_uart0_is_open(void)
+{
+	void __iomem *uart = (void __iomem *)NOVA_UART0_BASE;
+
+	return (readl(uart + UART_SFE) & 1) && (readl(uart + UART_LCR) & 0xff) == UART_LCR_8N1;
+}
+
+int nova_uart0_getc(void)
+{
+	void __iomem *uart = (void __iomem *)NOVA_UART0_BASE;
+
+	if (!(readl(uart + UART_LSR) & UART_LSR_DR))
+		return -1;
+	return readl(uart + UART_RBR) & 0xff;
+}
+
+void nova_uart0_send(const u8 *buf, int len)
+{
+	void __iomem *uart = (void __iomem *)NOVA_UART0_BASE;
+	ulong start = get_timer(0);
+	int i;
+
+	for (i = 0; i < len; i++) {
+		while (!(readl(uart + UART_LSR) & UART_LSR_THRE))
+			if (get_timer(start) > 10)
+				return;
+		writel(buf[i], uart + UART_THR);
+	}
+	while (!(readl(uart + UART_LSR) & UART_LSR_TEMT))
+		if (get_timer(start) > 10)
+			return;
+}
+
+bool nova_uart0_opened_at(u64 *us)
+{
+	struct nova_handoff *h = map_sysmem(CONFIG_NOVA_SPL_HANDOFF_ADDR, sizeof(*h));
+	bool ok = h->magic == NOVA_HANDOFF_MAGIC && h->check == nova_handoff_check(h->us);
+
+	if (ok)
+		*us = h->us;
+	memset(h, 0, sizeof(*h));
+	flush_dcache_range(CONFIG_NOVA_SPL_HANDOFF_ADDR, CONFIG_NOVA_SPL_HANDOFF_ADDR + ARCH_DMA_MINALIGN);
+	return ok;
+}
+#endif
diff --git a/board/rigol/nova_rk3399/nova_uart0.h b/board/rigol/nova_rk3399/nova_uart0.h
new file mode 100644
index 00000000..410b4743
--- /dev/null
+++ b/board/rigol/nova_rk3399/nova_uart0.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Rigol DHO800/DHO900 and MHO900 (RK3399): UART0, the line to the front-panel controller
+ * (1,500,000 baud, 8N1), driven by its registers: SPL opens it before it loads U-Boot proper, so
+ * every frame the controller sends from then on waits in the receive FIFO for U-Boot proper.
+ *
+ * Copyright (C) 2026 Olympian LED, Inc.
+ */
+#ifndef __NOVA_UART0_H
+#define __NOVA_UART0_H
+
+#include <linux/types.h>
+
+/* Clock xin24m, the pins GPIO2_C0/C1 only, the UART and its FIFOs reset, 1,500,000 8N1, FIFOs on. */
+void nova_uart0_open(void);
+/* Set up as nova_uart0_open() leaves it. */
+bool nova_uart0_is_open(void);
+/* The next byte received, or -1. */
+int nova_uart0_getc(void);
+/* Exactly `len` bytes out, within 10 ms. */
+void nova_uart0_send(const u8 *buf, int len);
+/*
+ * When SPL opened UART0, on the boot counter (us), from the record it left in DRAM
+ * (CONFIG_NOVA_SPL_HANDOFF_ADDR); false when there is none. The record is cleared.
+ */
+bool nova_uart0_opened_at(u64 *us);
+
+#endif
