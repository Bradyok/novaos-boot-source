 	default 0x4000000
 
+if NOVA_RK3399_MAINLINE
+
+config NOVA_MISC_BCB_LBA
+	hex "Card LBA of the misc message read (misc + 16 KiB)"
+	default 0x8020
+	help
+	  The PARM table's misc (0x2000@0x6000) plus 0x2000, plus 32
+	  sectors. Offset 0 of misc is never read.
+
+config NOVA_PARM_BYTES
+	hex "Bytes of the card's PARM block that must be the committed table"
+	default 0x3ae
+
+config NOVA_PARM_CRC32
+	hex "crc32 of those bytes"
+	default 0x4a377dc5
+	help
+	  The card's first PARM copy (NOVA_PARM_LBA) must be the table every
+	  LBA here comes from, byte for byte; otherwise Loader mode.
+
+config NOVA_RUNSTOP_WINDOW_MS
+	int "How long Run/Stop is listened for, from when SPL opened UART0 (ms)"
+	default 50
+	help
+	  SPL opens the front-panel UART0 before it loads U-Boot proper, so
+	  every frame sent from then on waits in the receive FIFO. U-Boot
+	  proper reads them all, and listens on until this long after the
+	  open, for a Run/Stop press or release anywhere in the stream.
+	  50 ms is the stock loader's own window.
+
+config NOVA_SPL_HANDOFF_ADDR
+	hex "Where SPL records when it opened UART0, for U-Boot proper"
+	default 0x1f1000
+	help
+	  16 bytes in the free RAM below 2 MiB: above the secure first MiB
+	  and the ramoops area (0x110000-0x1effff), beside the bootstage
+	  stash (BOOTSTAGE_STASH_ADDR), below U-Boot's and Linux's RAM.
+
+endif
+
 endif
