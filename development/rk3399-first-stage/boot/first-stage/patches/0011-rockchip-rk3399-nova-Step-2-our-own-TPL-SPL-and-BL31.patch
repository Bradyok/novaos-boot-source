 {
 	phys_addr_t a = get_prev_bl_fdt_addr();
 	const void *fdt;
@@ -673,14 +684,15 @@ int arch_setup_dest_addr(void)
 
 /* ------------------------------------------------------------------ the caches before relocation */
 
-#if IS_ENABLED(CONFIG_NOVA_RK3399_CHAINLOAD)
+#if IS_ENABLED(CONFIG_NOVA_RK3399_LADDER)
 /*
  * U-Boot proper is entered as the arm64 boot protocol enters a kernel, with the MMU and the
  * D-cache off, and here the I-cache off too (SCTLR_EL2 at its reset value), and U-Boot turns them
  * on only in board_r (enable_caches). Until then every instruction fetch and every load and store
