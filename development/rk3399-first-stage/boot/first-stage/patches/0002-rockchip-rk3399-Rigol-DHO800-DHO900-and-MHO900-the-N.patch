diff --git a/arch/arm/dts/rk3399-nova-rigol-u-boot.dtsi b/arch/arm/dts/rk3399-nova-rigol-u-boot.dtsi
new file mode 100644
index 00000000..4bc68abf
--- /dev/null
+++ b/arch/arm/dts/rk3399-nova-rigol-u-boot.dtsi
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * The U-Boot side of the NovaOS U-Boot proper's control DT (Rigol DHO800/DHO900, MHO900).
+ * rk3399-u-boot.dtsi first (the DMC node that sizes RAM from PMUGRF OS_REG2, the syscons,
+ * UART2's 24 MHz clock), then this board's aliases: mmc0 is the SD card, as in the NovaOS
+ * kernel DT, and nothing else is numbered.
+ *
+ * Copyright (C) 2026 Olympian LED, Inc.
+ */
+
+#include "rk3399-u-boot.dtsi"
+
+/ {
+	aliases {
+		mmc0 = &sdmmc;
+		/delete-property/ mmc1;
+		/delete-property/ pci0;
+		/delete-property/ spi1;
+	};
+
+	chosen {
+		/delete-property/ u-boot,spl-boot-order;
+	};
+};
diff --git a/arch/arm/dts/rk3399-nova-rigol.dtsi b/arch/arm/dts/rk3399-nova-rigol.dtsi
new file mode 100644
index 00000000..01a39c36
--- /dev/null
+++ b/arch/arm/dts/rk3399-nova-rigol.dtsi
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Rigol DHO800/DHO900 and MHO900 (RK3399): the control DT of the NovaOS U-Boot proper.
+ *
+ * Minimal on purpose. Enabled: the UART2 console (GPIO4_C3 RX / GPIO4_C4 TX, 115200, as the
+ * stock loaders and NovaOS use it) and the SD card on sdmmc (the boot medium: 4-bit, SD high
+ * speed at 50 MHz, 3.3 V signalling, no UHS, no supplies: U-Boot switches no rail and no
+ * signal voltage). Everything else that the SoC dtsi leaves enabled and that U-Boot has a
+ * driver for is disabled here, and the clock controllers lose their assigned rates, so U-Boot
+ * reprograms no PLL. No GPIO is driven: none of the DHO's or the MHO's board lines (among
+ * them pins that must never be driven on the other family, such as GPIO1_C2: the DHO's
+ * backlight enable, the MHO's LMK04826 chip select) appears in this tree.
+ *
+ * Copyright (C) 2026 Olympian LED, Inc.
+ */
+
+/ {
+	chosen {
+		stdout-path = "serial2:115200n8";
+	};
+};
+
+&uart2 {
+	status = "okay";
+};
+
+&sdmmc {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	disable-wp;
+	max-frequency = <50000000>;
+	no-mmc;
+	no-sdio;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_cd &sdmmc_bus4>;
+	/* The SoC dtsi's HCLK_SD rate: left as the loaders and the kernel set it. */
+	/delete-property/ assigned-clocks;
+	/delete-property/ assigned-clock-rates;
+	status = "okay";
+};
+
+/* No PLL reprogrammed: the rates stay as the stock loaders (or the kexec'd kernel) left them. */
+&cru {
+	/delete-property/ assigned-clocks;
+	/delete-property/ assigned-clock-rates;
+	/delete-property/ assigned-clock-parents;
+};
+
+&pmucru {
+	/delete-property/ assigned-clocks;
+	/delete-property/ assigned-clock-rates;
+	/delete-property/ assigned-clock-parents;
+};
+
+/* Left enabled by the SoC dtsi; U-Boot must probe none of them. */
+&{/watchdog@ff848000} {
+	status = "disabled";
+};
+
+&crypto0 {
+	status = "disabled";
+};
+
+&crypto1 {
+	status = "disabled";
+};
+
+&efuse0 {
+	status = "disabled";
+};
+
+&rktimer {
+	status = "disabled";
+};
+
+&dmac_bus {
+	status = "disabled";
+};
+
+&dmac_peri {
+	status = "disabled";
+};
+
+&rga {
+	status = "disabled";
+};
+
+&vpu {
+	status = "disabled";
+};
+
+&vdec {
+	status = "disabled";
+};
+
+&{/display-subsystem} {
+	status = "disabled";
+};
