diff --git a/board/rigol/nova_rk3399/Kconfig b/board/rigol/nova_rk3399/Kconfig
new file mode 100644
index 00000000..2070af5a
--- /dev/null
+++ b/board/rigol/nova_rk3399/Kconfig
@@ -0,0 +1,142 @@
+# SPDX-License-Identifier: GPL-2.0+
+#
+# Copyright (C) 2026 Olympian LED, Inc.
+
+if TARGET_NOVA_RIGOL_RK3399
+
+config SYS_BOARD
+	default "nova_rk3399"
+
+config SYS_VENDOR
+	default "rigol"
+
+config SYS_CONFIG_NAME
+	default "nova_rk3399"
+
+config BOARD_SPECIFIC_OPTIONS
+	def_bool y
+	select ROCKCHIP_LINUX_KERNEL_IMAGE_HEADER
+	select POSITION_INDEPENDENT
+	select SAVE_PREV_BL_FDT_ADDR
+	select LZ4
+	select CONSOLE_RECORD
+
+choice
+	prompt "What this U-Boot proper is for"
+	default NOVA_RK3399_KEXEC_TEST
+
+config NOVA_RK3399_KEXEC_TEST
+	bool "kexec test payload (NovaOS kexec_file_load, the watchdog running)"
+	help
+	  `nova kexec-test` times the SD card (mmc0 = sdmmc) and an LZ4
+	  decompression, appends the results to the ramoops pmsg zone and
+	  `nova reset` resets the SoC. It boots nothing and writes nothing
+	  to the card; it never feeds or stops the RK3399 watchdog beyond
+	  one restart of its counter at entry.
+
+config NOVA_RK3399_CHAINLOAD
+	bool "Step 1: booted by Rigol's stock U-Boot from recovery"
+	select SHA1
+	select OF_BOARD_SETUP
+	select OF_BOARD_SETUP_EXTENDED
+	help
+	  `nova boot` boots NovaOS from the LZ4 FIT that follows the
+	  ANDROID! image in `recovery`, or a new image on trial from the
+	  slot in `backup`, with the command line the stock U-Boot built.
+	  The RK3399 watchdog runs from board_early_init_f, and a record
+	  in PMUGRF OS_REG1 counts the attempts across resets
+	  (nova_chain.h): a trial that does not come up falls back to the
+	  committed image, and when no NovaOS image comes up the stock
+	  firmware boots. Only a card that holds no stock boot image
+	  either ends in the stock Rockusb.
+	  Entered by kexec from a running NovaOS instead (the watchdog
+	  already counting, no slot handed over), it boots the FIT passed
+	  as the kexec initrd, keeps the GIC's LPI tables for the next
+	  kernel, leaves the record alone and on any failure resets
+	  plainly.
+
+endchoice
+
+config NOVA_BUILD_ID
+	string "Build identifier logged at entry"
+	default "unknown"
+
+config NOVA_PMSG_ADDR
+	hex "Physical address of the ramoops pmsg zone"
+	default 0x1b0000
+	help
+	  The NovaOS DT's ramoops@110000 (0xe0000 bytes: one 0x20000 dmesg
+	  record, 0x80000 console, no ftrace, 0x40000 pmsg) puts the pmsg
+	  zone at 0x110000 + 0x20000 + 0x80000.
+
+config NOVA_PMSG_SIZE
+	hex "Size of the ramoops pmsg zone"
+	default 0x40000
+
+config NOVA_RECOVERY_LBA
+	hex "Card LBA of the recovery partition"
+	default 0x2e000
+	help
+	  The PARM table's recovery (0x20000@0x2c000) plus the SD offset
+	  of 0x2000 sectors.
+
+config NOVA_BACKUP_LBA
+	hex "Card LBA of the backup partition"
+	default 0x4e000
+	help
+	  The PARM table's backup (0x38000@0x4c000) plus 0x2000.
+
+config NOVA_SLOT_LBA
+	hex "Card LBA of the slot (backup + 32 MiB)"
+	default 0x5e000
+	help
+	  The slot a new NovaOS image is tried from, and where a copy of
+	  the committed one is kept: `backup` past its first 32 MiB, which
+	  hold stock's boot image (the image the stock U-Boot boots when
+	  it rejects `recovery`). Up to 64 MiB; the last 16 MiB of
+	  `backup` stay unused.
+
+config NOVA_SLOT_SECTORS
+	hex "Sectors of the slot"
+	default 0x20000
+
+config NOVA_BOOT_LBA
+	hex "Card LBA of the boot partition"
+	default 0x1e000
+	help
+	  The PARM table's boot (0x10000@0x1c000) plus 0x2000: read for
+	  the KRNL tag of stock's boot image only.
+
+config NOVA_KERNEL_LBA
+	hex "Card LBA of the kernel partition (the stock kernel's KRNL)"
+	default 0x12000
+	help
+	  The PARM table's kernel (0xc000@0x10000) plus 0x2000.
+
+config NOVA_RESOURCE_LBA
+	hex "Card LBA of the resource partition (the stock DTB's RSCE)"
+	default 0xa000
+	help
+	  The PARM table's resource (0x8000@0x8000) plus 0x2000.
+
+config NOVA_PARM_LBA
+	hex "Card LBA of the first PARM copy (the stock CMDLINE)"
+	default 0x2000
+
+config NOVA_TRUST_OS_BASE
+	hex "Base of the stock OP-TEE region cut out of the DRAM banks"
+	default 0x08400000
+
+config NOVA_TRUST_OS_SIZE
+	hex "Size of the stock OP-TEE region"
+	default 0x01e00000
+
+config NOVA_FIT_CONFIG
+	string "FIT configuration booted"
+	default "conf-1"
+
+config NOVA_FIT_MAX
+	hex "Largest FIT read from a slot"
+	default 0x4000000
+
+endif
