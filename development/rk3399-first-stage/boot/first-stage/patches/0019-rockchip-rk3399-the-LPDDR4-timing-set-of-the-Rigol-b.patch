diff --git a/board/rigol/nova_rk3399/Kconfig b/board/rigol/nova_rk3399/Kconfig
index f585e266..eafb4779 100644
--- a/board/rigol/nova_rk3399/Kconfig
+++ b/board/rigol/nova_rk3399/Kconfig
@@ -135,6 +135,23 @@ config NOVA_RK3399_DDR_GRF_IE_POLARITY
 	  as Rockchip's own copy does, but wrote to a local variable. This
 	  writes the GRF; off, the code is unchanged.
 
+config NOVA_RK3399_DDR_RIGOL
+	bool "LPDDR4 timing set of these boards (the scope's own values)"
+	depends on NOVA_RK3399_MAINLINE && RAM_ROCKCHIP_LPDDR4 && !NOVA_RK3399_DDR_856
+	help
+	  TPL loads rk3399-sdram-lpddr4-rigol.dtsi instead of the generic
+	  rk3399-sdram-lpddr4-100.dtsi, trains at 400 MHz and runs at
+	  856 MHz, the rate of the scope's own first stage. The 856 MHz copy
+	  and the boot copy hold the values the scope's own first stage
+	  leaves in the controller (read from a running scope);
+	  the 400 MHz copy is the generic one with tRFCab 280 ns, tXSR and
+	  tRAS(max) from the CXDB4CBAM datasheet. Above the boot rate the
+	  drive, termination and Vref are the scope's at both rates: SoC read
+	  termination 80 ohm, DQ/CA/CK drive 40 ohm, read Vref 20 % of VDDQ,
+	  DRAM pull-down 80 ohm with its pull-up calibrated to VDDQ/2.5, DRAM
+	  DQ termination 240 ohm. With NOVA_RK3399_DDR_400 the TPL stops at
+	  the 400 MHz training, as with the generic set.
+
 config NOVA_RK3399_LADDER
 	def_bool NOVA_RK3399_CHAINLOAD || NOVA_RK3399_MAINLINE
 	help
