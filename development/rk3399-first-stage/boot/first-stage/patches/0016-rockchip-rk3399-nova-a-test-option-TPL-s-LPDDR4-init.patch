diff --git a/board/rigol/nova_rk3399/nova_tpl_trace.c b/board/rigol/nova_rk3399/nova_tpl_trace.c
new file mode 100644
index 00000000..042e2878
--- /dev/null
+++ b/board/rigol/nova_rk3399/nova_tpl_trace.c
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2026 Olympian LED, Inc.
+ *
+ * NOVA_RK3399_TPL_TRACE: TPL's LPDDR4 init under the watchdog, with breadcrumbs that NovaOS reads after the
+ * reset (asm/arch-rockchip/nova_tpl_trace.h has the words). A test build only.
+ *
+ * Sources: the watchdog block and its use this early in a boot as TF-A v2.15 rk3399 does it on resume
+ * (plat/rockchip/rk3399/drivers/dram/suspend.c pmusram_enable_watchdog: GLB_RST_CON, TORR, enable, 0x76 to CRR;
+ * secure.c secure_watchdog_ungate: SGRF_SOC_CON3 bits 8 and 10), the registers' offsets from U-Boot's
+ * designware_wdt.c (CR, TORR, CRR) and the CCVR read live on the DHO924S; WDT0 at 0xff848000 (TF-A
+ * addressmap_shared.h, the Linux DT). The words that survive: PMU_SYS_REG0-3 (pmu_rk3399.h, 0xff3100f0-fc) and
+ * PMUGRF OS_REG3 kept a marker across a dw_wdt reset (CRU_GLB_RST_ST 0x10) and the stock chain into NovaOS on
+ * a DHO924S, 2026-10-29, with GLB_RST_CON 0x3, the value this code sets.
+ */
+
+#include <time.h>
+#include <asm/io.h>
+#include <asm/arch-rockchip/nova_tpl_trace.h>
+#include <linux/bitops.h>
+#include <linux/kernel.h>
+
+#define WDT_CR		0xff848000	/* bit 0 enable; bit 1 RMOD 0: the first expiry resets */
+#define WDT_TORR	0xff848004	/* [3:0] TOP, [7:4] TOP_INIT: a period of 2^(16 + TOP) cycles of pclk_wdt */
+#define WDT_CCVR	0xff848008	/* the counter, counting down */
+#define WDT_CRR		0xff84800c	/* 0x76 restarts the counter */
+#define WDT_RESTART	0x76
+#define CRU_GLB_SRST_FST	0xff760500	/* 0xfdb9: the first global software reset (TF-A soc.c) */
+#define CRU_GLB_RST_CON	0xff760510	/* 0x3: the watchdog and the TSADC each make the first global reset */
+#define SGRF_SOC_CON3	0xff33e00c	/* bit 8 the CA53 watchdog's pclk gate, bit 10 the CM0's; hi-word masked */
+#define PMUGRF_OS_REG3	0xff32030c
+#define PMU_SYS_REG(n)	(0xff3100f0 + 4 * (n))
+
+#define NOVA_TPL_MAGIC		0x4e540000	/* "NT" */
+#define NOVA_TPL_OSREG3		0x0b000000	/* top nibble 0: sys_reg3 version 0 */
+#define NOVA_TPL_F_DNL		BIT(12)	/* OS_REG0 held BOOT_BROM_DOWNLOAD at entry */
+#define NOVA_TPL_F_COUNTS	BIT(13)	/* the watchdog's counter moves */
+#define NOVA_TPL_F_ARMED	BIT(14)
+#define NOVA_TPL_WDT_MS		5000	/* the period aimed at: between 5 and 10 s (a power of two of cycles) */
+#define NOVA_TPL_POLL_US	200000	/* a busy-poll's deadline; each converges in micro- to milliseconds */
+
+/* TPL's entry word as first written, for the last breadcrumb (the LPDDR4 init overwrites OS_REG3) */
+static u32 entry_saved __section(".data");
+
+static u32 code(u32 step, u32 ch, u32 idx, u32 detail)
+{
+	return (step & 0xff) << 24 | (ch & 0xf) << 20 | (idx & 0xf) << 16 | (detail & 0xffff);
+}
+
+/* Earliest: save_boot_params, before the download flag is acted on. Clears what an earlier run left. */
+void nova_tpl_brom(u32 boot_mode, u32 bootsource)
+{
+	writel(NOVA_TPL_MAGIC, PMU_SYS_REG(0));
+	writel(0, PMU_SYS_REG(1));
+	writel(0, PMU_SYS_REG(2));
+	writel(0, PMU_SYS_REG(3));
+	entry_saved = NOVA_TPL_OSREG3 | (bootsource & 0xff) << 16 |
+		      (boot_mode == 0xef08a53c ? NOVA_TPL_F_DNL : 0);
+	writel(entry_saved, PMUGRF_OS_REG3);
+}
+
+void nova_tpl_step(u32 step, u32 ch, u32 idx, u32 detail, u32 value)
+{
+	u32 n = readl(PMU_SYS_REG(0));
+
+	if ((n & 0xffff0000) != NOVA_TPL_MAGIC)
+		n = NOVA_TPL_MAGIC;
+	writel(readl(PMU_SYS_REG(1)), PMU_SYS_REG(2));
+	writel(code(step, ch, idx, detail), PMU_SYS_REG(1));
+	writel(value, PMU_SYS_REG(3));
+	writel(NOVA_TPL_MAGIC | ((n + 1) & 0xffff), PMU_SYS_REG(0));
+}
+
+/* pclk_wdt in kHz: the counter's fall over 1 ms of the arch timer (24 MHz, set up before tpl_board_init) */
+static u32 wdt_khz(void)
+{
+	u32 c0, c1;
+	ulong t0;
+
+	writel(WDT_RESTART, WDT_CRR);
+	c0 = readl(WDT_CCVR);
+	t0 = timer_get_us();
+	while (timer_get_us() - t0 < 1000)
+		;
+	c1 = readl(WDT_CCVR);
+	return c0 - c1;
+}
+
+/* The TOP for a period of at least NOVA_TPL_WDT_MS at this rate (designware_wdt.c's rule), restarted with it. */
+static u32 wdt_set(u32 khz)
+{
+	u64 cycles = (u64)khz * NOVA_TPL_WDT_MS;
+	int top = cycles ? fls64(cycles - 1) - 16 : 15;
+
+	top = clamp(top, 0, 15);
+	writel(top | top << 4, WDT_TORR);
+	writel(WDT_RESTART, WDT_CRR);
+	return top;
+}
+
+static void entry_word(u32 khz, u32 top)
+{
+	u32 r = readl(PMUGRF_OS_REG3);
+
+	if ((r & 0xff000000) != NOVA_TPL_OSREG3)
+		return;		/* the LPDDR4 init has written its own value: leave it */
+	r &= 0x00ff0000 | NOVA_TPL_F_DNL;
+	r |= NOVA_TPL_OSREG3 | NOVA_TPL_F_ARMED | (khz ? NOVA_TPL_F_COUNTS : 0) | (top & 0xf) << 8 |
+	     min(khz / 1000, 0xffU);
+	entry_saved = r;
+	writel(r, PMUGRF_OS_REG3);
+}
+
+/* tpl_board_init: start the watchdog, measure its clock, set a period of 5-10 s. */
+void nova_tpl_arm(void)
+{
+	u32 khz, top;
+
+	writel(0x3, CRU_GLB_RST_CON);
+	writel(BIT(8 + 16) | BIT(10 + 16), SGRF_SOC_CON3);	/* both pclks on (value bits 0) */
+	writel(0xff, WDT_TORR);					/* the longest period while it is measured */
+	writel(BIT(0), WDT_CR);
+	khz = wdt_khz();
+	top = wdt_set(khz);
+	entry_word(khz, top);
+	nova_tpl_step(NOVA_TPL_ENTRY, NOVA_TPL_NOCH, 0, top << 8 | min(khz / 1000, 0xffU), khz);
+}
+
+/* Again once the clock driver has set the PLLs (pclk_alive comes from the GPLL): sdram_init's entry. */
+void nova_tpl_tune(void)
+{
+	u32 khz = wdt_khz();
+	u32 top = wdt_set(khz);
+
+	nova_tpl_step(NOVA_TPL_ENTRY, NOVA_TPL_NOCH, 1, top << 8 | min(khz / 1000, 0xffU), khz);
+}
+
+/* the poll being timed: in .data, as TPL clears .bss only after board_init_f (bootrom.c's brom_ctx likewise) */
+static struct {
+	ulong start;
+	u32 id;
+	u32 ch;
+} poll __section(".data");
+
+void nova_tpl_poll_begin(u32 id, u32 ch)
+{
+	poll.start = timer_get_us();
+	poll.id = id;
+	poll.ch = ch;
+}
+
+static void __noreturn wait_for_reset(void)
+{
+	/* the watchdog resets the SoC; if its counter never moved, the first global software reset instead */
+	if (!(readl(PMUGRF_OS_REG3) & NOVA_TPL_F_COUNTS) && (readl(PMUGRF_OS_REG3) & 0xff000000) == NOVA_TPL_OSREG3)
+		writel(0xfdb9, CRU_GLB_SRST_FST);
+	while (1)
+		;
+}
+
+void nova_tpl_poll(u32 value)
+{
+	if (timer_get_us() - poll.start < NOVA_TPL_POLL_US)
+		return;
+	nova_tpl_step(NOVA_TPL_TIMEOUT | poll.id, poll.ch, 0, 0, value);
+	wait_for_reset();
+}
+
+void __noreturn nova_tpl_hang(u32 which, u32 ch)
+{
+	nova_tpl_step(NOVA_TPL_HANG, ch, which, 0, 0);
+	wait_for_reset();
+}
+
+/*
+ * The RAM probe returned: the longest period for what follows, the BootROM's download of the 472 (768 KiB of our
+ * SPL and FIT take many seconds over its control transfers), SPL, BL31 and U-Boot proper up to its own arming of
+ * the watchdog (nova_wdog_arm: TORR 0xff, CR = enable, so RMOD 0 again, a restart). TOP 15 and RMOD 1: the first
+ * expiry only raises the watchdog's interrupt, which nothing here takes, and the second resets (Linux dw_wdt.c,
+ * the response mode its pretimeout uses), so twice 2^31 cycles, about 43 s at 99 MHz.
+ */
+void nova_tpl_done(int ret)
+{
+	writel(0xff, WDT_TORR);
+	writel(BIT(0) | BIT(1), WDT_CR);
+	writel(WDT_RESTART, WDT_CRR);
+	nova_tpl_step(NOVA_TPL_DONE, NOVA_TPL_NOCH, 0, ret & 0xffff, entry_saved);
+}
