diff --git a/arch/arm/include/asm/arch-rockchip/nova_tpl_trace.h b/arch/arm/include/asm/arch-rockchip/nova_tpl_trace.h
new file mode 100644
index 00000000..590c8099
--- /dev/null
+++ b/arch/arm/include/asm/arch-rockchip/nova_tpl_trace.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright (C) 2026 Olympian LED, Inc.
+ *
+ * NOVA_RK3399_TPL_TRACE (a test, off by default): TPL's LPDDR4 init made self-recovering and readable with no
+ * UART. TPL starts the RK3399 watchdog early, so a hang anywhere resets the SoC and the BootROM boots the card as
+ * usual; every step of the init writes a breadcrumb into registers that keep their value across that reset and
+ * through the stock loader chain into NovaOS (PMU_SYS_REG0-3, PMUGRF OS_REG3, as measured on
+ * the DHO924S), and every busy-poll of the LPDDR4 init has a deadline that records which poll, on which channel,
+ * with what value, then waits for the watchdog. NovaOS reads them with devmem.
+ *
+ * The words (every one read back with `busybox devmem <addr> 32`):
+ *   PMU_SYS_REG0 0xff3100f0  0x4e54nnnn: "NT" and the number of breadcrumbs written (n)
+ *   PMU_SYS_REG1 0xff3100f4  the last step:  [31:24] step, [23:20] channel (0xf: none), [19:16] rank or
+ *                            index, [15:0] detail
+ *   PMU_SYS_REG2 0xff3100f8  the step before it, the same layout
+ *   PMU_SYS_REG3 0xff3100fc  the last step's value (a poll's register when it timed out)
+ *   PMUGRF OS_REG3 0xff32030c  TPL's entry, written once: 0x0b000000 | the BootROM's boot-source word [23:16]
+ *                            | flags [15:12] (bit 12: OS_REG0 held the BootROM download flag, bit 13: the
+ *                            watchdog counts, bit 14: armed) | the watchdog's TOP [11:8] | pclk_wdt in MHz
+ *                            [7:0]. Its top nibble stays 0, so every DRAM-size decoder (sys_reg3 version
+ *                            < 2) ignores it; the LPDDR4 init overwrites it with its own value when it gets
+ *                            that far (dram_all_config).
+ */
+
+#ifndef _ASM_ARCH_ROCKCHIP_NOVA_TPL_TRACE_H
+#define _ASM_ARCH_ROCKCHIP_NOVA_TPL_TRACE_H
+
+#include <linux/types.h>
+
+/* steps */
+#define NOVA_TPL_ENTRY		0x01	/* the watchdog armed (detail: TOP << 8 | pclk_wdt MHz) */
+#define NOVA_TPL_SDRAM		0x10	/* sdram_init entered, after the DDR clock was set (detail: MHz) */
+#define NOVA_TPL_RANK		0x11	/* rank detect: this channel, this rank (2, then 1) */
+#define NOVA_TPL_PCTL_CFG	0x12	/* phy_pctrl_reset, phy_dll_bypass_set, pctl_cfg of a channel */
+#define NOVA_TPL_PCTL_START	0x13	/* pctl_start (detail: channel mask) */
+#define NOVA_TPL_MR_ACCESS	0x14	/* lpddr4_mr_detect: the DRAM read and write of the rank (value: address) */
+#define NOVA_TPL_MR_READ	0x15	/* lpddr4_mr_detect: MR5, MR12, MR14 read (value: mr5 | mr12 << 8 | mr14 << 16) */
+#define NOVA_TPL_RANK_DONE	0x16	/* data_training_first returned (detail: its return value) */
+#define NOVA_TPL_SET_RATE	0x20	/* lpddr4_set_rate (index: the ctl fn; detail: MHz) */
+#define NOVA_TPL_SET_CTL	0x21	/* lpddr4_set_ctl: the PHY set, the controller's switch next */
+#define NOVA_TPL_CLK	0x22	/* lpddr4_set_ctl: the DPLL set to the new rate */
+#define NOVA_TPL_TRAIN		0x23	/* data_training of a channel (index: training flags) */
+#define NOVA_TPL_TRAIN_STEP	0x24	/* one training: index 1 CA, 2 WL, 3 RG, 4 RL, 5 WDQL (detail: cs) */
+#define NOVA_TPL_TRAIN_DONE	0x25	/* data_training returned (detail: its return value) */
+#define NOVA_TPL_CAP		0x30	/* dram_detect_cap of a channel */
+#define NOVA_TPL_ALL_CONFIG	0x31	/* dram_all_config: OS_REG2/3 next (detail: the entry word >> 8; value: OS_REG2) */
+#define NOVA_TPL_SDRAM_DONE	0x3f	/* sdram_init returned (detail: its return value) */
+#define NOVA_TPL_DONE		0x40	/* the RAM probe returned (detail: its return value; value: the entry word); TOP 15 next */
+#define NOVA_TPL_HANG		0x7e	/* an explicit hang of the init (index: which; detail: channel) */
+#define NOVA_TPL_TIMEOUT	0x80	/* | poll id: a busy-poll passed its deadline (value: the register) */
+
+/* the busy-polls with a deadline */
+#define NOVA_POLL_PCTL_START	0x01	/* pctl_start: denali_ctl[203] bit 3 */
+#define NOVA_POLL_CA		0x02	/* data_training_ca: PI_174 */
+#define NOVA_POLL_WL		0x03	/* data_training_wl */
+#define NOVA_POLL_RG		0x04	/* data_training_rg */
+#define NOVA_POLL_RL		0x05	/* data_training_rl */
+#define NOVA_POLL_WDQL		0x06	/* data_training_wdql */
+#define NOVA_POLL_IDLE_REQ	0x07	/* lpddr4_set_ctl: pmu_bus_idle_st bits 18-19 set */
+#define NOVA_POLL_CIC_CHANGE	0x08	/* lpddr4_set_ctl: cic_status0 bit 2 */
+#define NOVA_POLL_CIC_DONE	0x09	/* lpddr4_set_ctl: cic_status0 bit 0 */
+#define NOVA_POLL_IDLE_CLR	0x0a	/* lpddr4_set_ctl: pmu_bus_idle_st bits 18-19 clear */
+
+#define NOVA_TPL_NOCH		0xf
+
+#if defined(CONFIG_TPL_BUILD) && defined(CONFIG_NOVA_RK3399_TPL_TRACE)
+void nova_tpl_brom(u32 boot_mode, u32 bootsource);
+void nova_tpl_arm(void);
+void nova_tpl_tune(void);
+void nova_tpl_step(u32 step, u32 ch, u32 idx, u32 detail, u32 value);
+void nova_tpl_poll_begin(u32 id, u32 ch);
+void nova_tpl_poll(u32 value);
+void __noreturn nova_tpl_hang(u32 which, u32 ch);
+void nova_tpl_done(int ret);
+#else
+static inline void nova_tpl_brom(u32 boot_mode, u32 bootsource) {}
+static inline void nova_tpl_arm(void) {}
+static inline void nova_tpl_tune(void) {}
+static inline void nova_tpl_step(u32 step, u32 ch, u32 idx, u32 detail, u32 value) {}
+static inline void nova_tpl_poll_begin(u32 id, u32 ch) {}
+static inline void nova_tpl_poll(u32 value) {}
+static inline void nova_tpl_done(int ret) {}
+static inline void __noreturn nova_tpl_hang(u32 which, u32 ch)
+{
+	while (1)
+		;
+}
+#endif
+
+#endif
