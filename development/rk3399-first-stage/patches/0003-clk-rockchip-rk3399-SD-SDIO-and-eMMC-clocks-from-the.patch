From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brady <brady@aioscilloscope.com>
Date: Tue, 27 Oct 2026 12:00:00 +0000
Subject: [PATCH 03/10] clk: rockchip: rk3399: SD, SDIO and eMMC clocks from
 the GPLL as it runs

Copyright (C) 2026 Olympian LED, Inc.

The RK3399 clock driver computes the SD, SDIO and eMMC dividers from
GPLL_HZ (594 MHz), the rate its own rkclk_init() programs. U-Boot proper
that was not started by its own SPL does not run rkclk_init() (no
handoff), and finds the GPLL where the previous stage left it: Linux's
rk3399 device trees set it to 800 MHz. Asked for a 50 MHz SD high-speed
clock, the driver then programs clk_sdmmc = 800 MHz / ceil(297 / 50) =
133.3 MHz, and the host's fixed divide-by-two runs the card at 66.7 MHz,
a third over the SD high-speed limit, while the MMC core believes it
runs at 50 MHz.

Read the GPLL's rate from its registers (24 MHz / REFDIV * FBDIV, plus
the fraction in fractional mode, / POSTDIV1 / POSTDIV2; the oscillator in
slow mode) and use it for these dividers. Where rkclk_init() has run the
GPLL reads back as GPLL_HZ, so nothing changes there.

rk3399_mmc_get_clk() also divided by twice the divider field plus one
instead of twice the divider (the field plus one); it now returns the
rate the hardware makes.

Signed-off-by: Brady <brady@aioscilloscope.com>
---
 drivers/clk/rockchip/clk_rk3399.c | 46 +++++++++++++++++++++++++++----
 1 file changed, 40 insertions(+), 6 deletions(-)

diff --git a/drivers/clk/rockchip/clk_rk3399.c b/drivers/clk/rockchip/clk_rk3399.c
index 6e87db18..f5589bc1 100644
--- a/drivers/clk/rockchip/clk_rk3399.c
+++ b/drivers/clk/rockchip/clk_rk3399.c
@@ -722,6 +722,39 @@ static ulong rk3399_vop_set_clk(struct rockchip_cru *cru, ulong clk_id, u32 hz)
 	return hz;
 }
 
+/*
+ * The GPLL's rate as it runs. U-Boot proper that was not started by its own SPL (chainloaded
+ * by another boot loader, or entered through Linux's kexec) finds the GPLL where that stage
+ * left it, which need not be GPLL_HZ: Linux's rk3399 DTs set 800 MHz. A divider computed for
+ * GPLL_HZ there runs the SD card at 800 / 6 / 2 = 66.7 MHz when 50 MHz was asked for.
+ */
+static ulong rk3399_gpll_get_rate(struct rockchip_cru *cru)
+{
+	u32 con0 = readl(&cru->gpll_con[0]);
+	u32 con1 = readl(&cru->gpll_con[1]);
+	u32 con2 = readl(&cru->gpll_con[2]);
+	u32 con3 = readl(&cru->gpll_con[3]);
+	u32 refdiv = (con1 & PLL_REFDIV_MASK) >> PLL_REFDIV_SHIFT;
+	u32 postdiv1 = (con1 & PLL_POSTDIV1_MASK) >> PLL_POSTDIV1_SHIFT;
+	u32 postdiv2 = (con1 & PLL_POSTDIV2_MASK) >> PLL_POSTDIV2_SHIFT;
+	u64 rate;
+
+	switch ((con3 & PLL_MODE_MASK) >> PLL_MODE_SHIFT) {
+	case PLL_MODE_SLOW:
+		return OSC_HZ;
+	case PLL_MODE_NORM:
+		break;
+	default:
+		return 32768;
+	}
+	if (!refdiv || !postdiv1 || !postdiv2)
+		return GPLL_HZ;
+	rate = (u64)OSC_HZ * ((con0 & PLL_FBDIV_MASK) >> PLL_FBDIV_SHIFT);
+	if (!(con3 & PLL_DSMPD_MASK))
+		rate += ((u64)OSC_HZ * ((con2 & PLL_FRACDIV_MASK) >> PLL_FRACDIV_SHIFT)) >> 24;
+	return rate / refdiv / postdiv1 / postdiv2;
+}
+
 static ulong rk3399_mmc_get_clk(struct rockchip_cru *cru, uint clk_id)
 {
 	u32 div, con;
@@ -747,12 +780,12 @@ static ulong rk3399_mmc_get_clk(struct rockchip_cru *cru, uint clk_id)
 		return -EINVAL;
 	}
 
-	div *= (con & CLK_EMMC_DIV_CON_MASK) >> CLK_EMMC_DIV_CON_SHIFT;
+	div *= ((con & CLK_EMMC_DIV_CON_MASK) >> CLK_EMMC_DIV_CON_SHIFT) + 1;
 	if ((con & CLK_EMMC_PLL_MASK) >> CLK_EMMC_PLL_SHIFT
 			== CLK_EMMC_PLL_SEL_24M)
-		return DIV_TO_RATE(OSC_HZ, div);
+		return OSC_HZ / div;
 	else
-		return DIV_TO_RATE(GPLL_HZ, div);
+		return rk3399_gpll_get_rate(cru) / div;
 }
 
 static void rk3399_dwmmc_set_clk(struct rockchip_cru *cru,
@@ -760,7 +793,7 @@ static void rk3399_dwmmc_set_clk(struct rockchip_cru *cru,
 {
 	/* Select clk_sdmmc source from GPLL by default */
 	/* mmc clock defaulg div 2 internal, provide double in cru */
-	int src_clk_div = DIV_ROUND_UP(GPLL_HZ / 2, set_rate);
+	int src_clk_div = DIV_ROUND_UP(rk3399_gpll_get_rate(cru) / 2, set_rate);
 
 	if (src_clk_div > 128) {
 		/* use 24MHz source for 400KHz clock */
@@ -791,9 +824,10 @@ static ulong rk3399_mmc_set_clk(struct rockchip_cru *cru,
 		rk3399_dwmmc_set_clk(cru, 16, set_rate);
 		break;
 	case SCLK_EMMC: {
+		ulong gpll = rk3399_gpll_get_rate(cru);
 		int aclk_emmc = 198 * MHz;
 		/* Select aclk_emmc source from GPLL */
-		int src_clk_div = DIV_ROUND_UP(GPLL_HZ, aclk_emmc);
+		int src_clk_div = DIV_ROUND_UP(gpll, aclk_emmc);
 
 		assert(src_clk_div - 1 < 32);
 
@@ -803,7 +837,7 @@ static ulong rk3399_mmc_set_clk(struct rockchip_cru *cru,
 			     (src_clk_div - 1) << ACLK_EMMC_DIV_CON_SHIFT);
 
 		/* Select clk_emmc source from GPLL too */
-		src_clk_div = DIV_ROUND_UP(GPLL_HZ, set_rate);
+		src_clk_div = DIV_ROUND_UP(gpll, set_rate);
 		assert(src_clk_div - 1 < 128);
 
 		rk_clrsetreg(&cru->clksel_con[22],
