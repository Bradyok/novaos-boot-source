# What this release's boot chain was built from and with; build.sh reads it. Each tree in src/ is the
# upstream commit named here with the listed patches applied (src/UPSTREAM.sha256: the files left as
# upstream has them).
# src/u-boot-first-stage: u-boot v2026.10, https://source.denx.de/u-boot/u-boot.git commit 5508406582f6f7120dce0c4b3059819a41788db2 (tree c54aa18f1c43c1b8b292434cc74cdc11e002f851), with 0001-mmc-dw_mmc-poll-the-FIFO-every-microsecond-not-every.patch 0002-rockchip-rk3399-add-the-Rigol-DHO800-DHO900-and-MHO9.patch 0003-rigol-rk3399-the-boot-ladder-as-a-text-environment.patch
# src/tf-a-v2.15.0: tf-a v2.15.0, https://github.com/ARM-software/arm-trusted-firmware.git commit da738d5eae93af342fdc4995dd3c05acb4c9d757 (tree 9b8ab09105e08b5d3593813ec1442e28720e3c00), as published
# src/u-boot-uboot-proper: u-boot v2026.10, https://source.denx.de/u-boot/u-boot.git commit 5508406582f6f7120dce0c4b3059819a41788db2 (tree c54aa18f1c43c1b8b292434cc74cdc11e002f851), with 0001-rockchip-an-option-for-a-Linux-arm64-Image-header-on.patch 0002-rockchip-rk3399-Rigol-DHO800-DHO900-and-MHO900-the-N.patch 0003-clk-rockchip-rk3399-SD-SDIO-and-eMMC-clocks-from-the.patch 0004-lib-lz4-inline-the-decoder-s-fixed-size-copies-unali.patch 0005-rockchip-rk3399-nova-the-MMU-and-the-caches-on-befor.patch 0006-rockchip-rk3399-nova-keep-the-stock-U-Boot-s-boot-lo.patch 0007-lib-string-memmove-copies-backward-a-word-at-a-time.patch
# src/lz4-1.10.0: lz4 v1.10.0, https://github.com/lz4/lz4/releases/download/v1.10.0/lz4-1.10.0.tar.gz (sha256 537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b), as published
UBOOT_TAG=v2026.10
UBOOT_COMMIT=5508406582f6f7120dce0c4b3059819a41788db2
TFA_TAG=v2.15.0
TFA_COMMIT=da738d5eae93af342fdc4995dd3c05acb4c9d757
# the U-Boot commit's date: every timestamp in the binaries
SOURCE_DATE_EPOCH=1791236133
LANES="first-stage uboot-proper"
# first-stage: Arm GNU Toolchain tarballs (BUILDING.txt), TF-A at LOG_LEVEL errors only
FIRST_STAGE_UBOOT=u-boot-first-stage
FIRST_STAGE_TFA=tf-a-v2.15.0
FIRST_STAGE_FAMILIES="dho900 mho900"
FIRST_STAGE_TFA_LOG_LEVEL=10
FIRST_STAGE_AARCH64_TC=arm-gnu-toolchain-14.2.rel1-x86_64-aarch64-none-elf
FIRST_STAGE_M0_TC=arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi
FIRST_STAGE_CC="aarch64-none-elf-gcc (Arm GNU Toolchain 14.2.Rel1 (Build arm-14.52)) 14.2.1 20241119"
FIRST_STAGE_M0_CC="arm-none-eabi-gcc (Arm GNU Toolchain 14.2.Rel1 (Build arm-14.52)) 14.2.1 20241119"
# uboot-proper: the cross toolchain the release was built with (BUILDING.txt); the build id it logs
UBOOT_PROPER_UBOOT=u-boot-uboot-proper
UBOOT_PROPER_FAMILIES="dho900 mho900"
UBOOT_PROPER_FLAVORS="kexec-test chainload"
UBOOT_PROPER_BUILD_ID=1dd98c584b86
UBOOT_PROPER_CROSS_COMPILE=aarch64-linux-gnu-
UBOOT_PROPER_CC="aarch64-linux-gnu-gcc (Ubuntu 15.2.0-16ubuntu1) 15.2.0"
UBOOT_PROPER_LD="GNU ld (GNU Binutils for Ubuntu) 2.46"
UBOOT_PROPER_KBUILD_BUILD_USER=nova
UBOOT_PROPER_KBUILD_BUILD_HOST=builder
# the chainload recovery image of each family (install/), and the stage-B image it carries
CHAIN_FAMILIES="dho900 mho900"
LZ4_TREE=lz4-1.10.0
CHAIN_STAGE_B_SHA256_dho900=514e9343ebc45fb27ad586e18ec20f9474c24b89ece98e7c2e082c8e48423118
CHAIN_STAGE_B_SHA256_mho900=4588745aa2f74512d5cdc241a200c8fae759234bbd224dba856cd0fd56c653a1
