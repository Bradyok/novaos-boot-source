diff --git a/board/rigol/rigol_rk3399/rigol_bootflag.h b/board/rigol/rigol_rk3399/rigol_bootflag.h
new file mode 100644
index 00000000..31aabb43
--- /dev/null
+++ b/board/rigol/rigol_rk3399/rigol_bootflag.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright (C) 2026 Olympian LED, Inc.
+ *
+ * The reboot flags of the Rigol DHO800/DHO900 and MHO900, as the new chain
+ * keeps them (plain C with no U-Boot header: a host program can check it).
+ *
+ * PMUGRF OS_REG0 (0xff320300) holds 0x5242c3xx after a Linux reboot that
+ * names a mode (the kernel's reboot-mode node writes it), or 0x1888aaff
+ * after an interrupted Rockusb sector write. The stock boot loader reads it
+ * at reset and acts on the low byte; 0x1888aaff means Loader to it.
+ *
+ * What this chain does with them:
+ *   low byte 1 (mode-loader, mode-bootloader)  Loader (Rockusb), no timeout
+ *   low byte 3 (mode-recovery)                 boot the recovery slot first
+ *   0x1888aaff (loader error)                  Loader
+ *   anything else                              a normal boot
+ * Low bytes 6 and 7 ask the stock firmware for a data wipe (its recovery
+ * with --wipe_data). This chain never acts on them: they are a normal
+ * boot, and nothing here writes misc.
+ *
+ * Every value here is one a running scope writes or reads.
+ */
+
+#ifndef __RIGOL_BOOTFLAG_H
+#define __RIGOL_BOOTFLAG_H
+
+#define RIGOL_REBOOT_FLAG	0x5242c300u
+#define RIGOL_LOADER_ERROR	0x1888aaffu
+
+enum rigol_bootmode {
+	RIGOL_BOOT_NORMAL,
+	RIGOL_BOOT_LOADER,
+	RIGOL_BOOT_RECOVERY,
+};
+
+static inline enum rigol_bootmode rigol_decode_reboot_flag(unsigned int flag)
+{
+	if (flag == RIGOL_LOADER_ERROR)
+		return RIGOL_BOOT_LOADER;
+	/* The consumed form 0xc35242xx, zero, and anything unknown: normal. */
+	if ((flag & ~0xffu) != RIGOL_REBOOT_FLAG)
+		return RIGOL_BOOT_NORMAL;
+
+	switch (flag & 0xffu) {
+	case 0x01:
+		return RIGOL_BOOT_LOADER;
+	case 0x03:
+		return RIGOL_BOOT_RECOVERY;
+	default:
+		return RIGOL_BOOT_NORMAL;
+	}
+}
+
+static inline const char *rigol_bootmode_name(enum rigol_bootmode mode)
+{
+	switch (mode) {
+	case RIGOL_BOOT_LOADER:
+		return "loader";
+	case RIGOL_BOOT_RECOVERY:
+		return "recovery";
+	default:
+		return "normal";
+	}
+}
+
+#endif
diff --git a/board/rigol/rigol_rk3399/rigol_rk3399.c b/board/rigol/rigol_rk3399/rigol_rk3399.c
new file mode 100644
index 00000000..6ea9a1d7
--- /dev/null
+++ b/board/rigol/rigol_rk3399/rigol_rk3399.c
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2026 Olympian LED, Inc.
+ *
+ * Rigol DHO800/DHO900 and MHO900 (RK3399): what NovaOS and Rigol's own
+ * firmware expect of their boot loader, kept by the mainline chain:
+ *
+ *  - the reboot flag in PMUGRF OS_REG0, read before mainline's
+ *    setup_boot_mode() clears it (rigol_bootflag.h);
+ *  - Run/Stop at power-on enters Loader mode: the front-panel controller's
+ *    frames arrive on UART0 at 1,500,000 baud;
+ *  - the power-on-mode frame to that controller on every normal boot;
+ *  - no download key: SARADC channel 1 is not wired on this board, and
+ *    mainline's ADC check would reset into Maskrom.
+ *
+ * The misc bootloader message and the boot ladder are in the text
+ * environment (rigol_rk3399.env): the message is read at misc + 16 KiB only.
+ *
+ * UART0 is opened in SPL, before U-Boot is loaded, so every frame sent from
+ * then on waits in the receive FIFO for U-Boot proper to read. Its pins are
+ * GPIO2_C0/C1 only: GPIO2_C2 (UART0 CTS) is PCIe PERST# on the DHO and the
+ * AFG receive line on a rev-1 MHO, and is never touched.
+ *
+ * The front-panel controller's frames and baud rate are its own interface.
+ */
+
+#include <env.h>
+#include <time.h>
+#include <asm/io.h>
+#include <asm/arch-rockchip/cru_rk3399.h>
+#include <asm/arch-rockchip/grf_rk3399.h>
+#include <asm/arch-rockchip/hardware.h>
+#include <linux/delay.h>
+#include <linux/compiler.h>
+#include <linux/string.h>
+#include "rigol_bootflag.h"
+
+/* Register blocks (rk3399-base.dtsi; GRF as in mach-rockchip/rk3399/rk3399.c). */
+#define RK3399_CRU_BASE		0xff760000
+#define RK3399_GRF_BASE		0xff770000
+#define RK3399_PMUGRF_OS_REG0	0xff320300	/* CONFIG_ROCKCHIP_BOOT_MODE_REG */
+#define RIGOL_UART0_BASE	0xff180000	/* uart0: serial@ff180000 */
+
+/*
+ * DesignWare APB UART, 32-bit registers (reg-shift 2). SRR (0x88) and SFE
+ * (0x98) are DesignWare additions to the 16550 set: SRR resets the UART
+ * and its FIFOs, SFE turns the FIFOs on.
+ */
+#define UART_RBR		0x00
+#define UART_THR		0x00
+#define UART_DLL		0x00
+#define UART_DLH		0x04
+#define UART_IER		0x04
+#define UART_LCR		0x0c
+#define UART_LSR		0x14
+#define UART_SRR		0x88
+#define UART_SFE		0x98
+
+#define UART_LCR_8N1		0x03
+#define UART_LCR_DLAB		0x80
+#define UART_LSR_DR		0x01
+#define UART_LSR_THRE		0x20
+#define UART_LSR_TEMT		0x40
+#define UART_SRR_ALL		0x07	/* UART, receive FIFO and transmit FIFO reset */
+
+/*
+ * CRU, as Linux's drivers/clk/rockchip/clk-rk3399.c (v6.12) describes it:
+ * clk_uart0 is a mux in CLKSEL_CON33 bits [9:8] of {clk_uart0_div,
+ * clk_uart0_frac, xin24m}; pclk_uart0's gate is CLKGATE_CON22 bit 0.
+ */
+#define CRU_UART0_SEL_SHIFT	8
+#define CRU_UART0_SEL_MASK	(3 << CRU_UART0_SEL_SHIFT)
+#define CRU_UART0_SEL_XIN24M	(2 << CRU_UART0_SEL_SHIFT)
+#define CRU_PCLK_UART0_GATE	(1 << 0)
+
+/* 24 MHz / (16 x 1,500,000) = 1: the front-panel controller's 1,500,000 baud. */
+#define UART0_DIVISOR		1
+
+static void __maybe_unused rigol_uart0_open(void)
+{
+	struct rockchip_cru *cru = (void *)RK3399_CRU_BASE;
+	struct rk3399_grf_regs *grf = (void *)RK3399_GRF_BASE;
+	void __iomem *uart = (void __iomem *)RIGOL_UART0_BASE;
+
+	rk_clrsetreg(&cru->clksel_con[33], CRU_UART0_SEL_MASK, CRU_UART0_SEL_XIN24M);
+	rk_clrreg(&cru->clkgate_con[22], CRU_PCLK_UART0_GATE);
+	rk_clrsetreg(&grf->gpio2c_iomux,
+		     GRF_GPIO2C0_SEL_MASK | GRF_GPIO2C1_SEL_MASK,
+		     GRF_UART0BT_SIN << GRF_GPIO2C0_SEL_SHIFT |
+		     GRF_UART0BT_SOUT << GRF_GPIO2C1_SEL_SHIFT);
+
+	writel(UART_SRR_ALL, uart + UART_SRR);
+	udelay(10);
+	writel(0, uart + UART_IER);
+	writel(UART_LCR_DLAB | UART_LCR_8N1, uart + UART_LCR);
+	writel(UART0_DIVISOR & 0xff, uart + UART_DLL);
+	writel(UART0_DIVISOR >> 8, uart + UART_DLH);
+	writel(UART_LCR_8N1, uart + UART_LCR);
+	writel(1, uart + UART_SFE);	/* FIFOs on */
+}
+
+#ifdef CONFIG_XPL_BUILD
+
+#ifndef CONFIG_TPL_BUILD
+/* Called by spl_board_init() (mach-rockchip/rk3399/rk3399.c), in SPL only. */
+void led_setup(void)
+{
+	rigol_uart0_open();
+}
+#endif
+
+#else /* U-Boot proper */
+
+/* Front-panel frames: FA b1 b2 crc AF, crc the CRC-7/MMC of b1 and b2. */
+static const u8 rigol_runstop_press[5] = { 0xfa, 0x08, 0x0c, 0x34, 0xaf };
+static const u8 rigol_runstop_release[5] = { 0xfa, 0x08, 0x00, 0x58, 0xaf };
+static const u8 rigol_power_mode_auto[5] = { 0xfa, 0x05, 0x05, 0x0a, 0xaf };
+
+static bool rigol_uart0_is_open(void)
+{
+	void __iomem *uart = (void __iomem *)RIGOL_UART0_BASE;
+
+	return (readl(uart + UART_SFE) & 1) &&
+	       (readl(uart + UART_LCR) & 0xff) == UART_LCR_8N1;
+}
+
+/*
+ * Every frame the controller sent since SPL opened UART0 (the receive FIFO),
+ * then CONFIG_RIGOL_RUNSTOP_WINDOW_MS more: a Run/Stop press or release
+ * anywhere in that stream counts. Other keys' frames are skipped.
+ */
+static bool rigol_runstop_seen(void)
+{
+	void __iomem *uart = (void __iomem *)RIGOL_UART0_BASE;
+	ulong start = get_timer(0);
+	u8 w[5] = { 0 };
+
+	for (;;) {
+		while (readl(uart + UART_LSR) & UART_LSR_DR) {
+			memmove(w, w + 1, sizeof(w) - 1);
+			w[4] = readl(uart + UART_RBR) & 0xff;
+			if (!memcmp(w, rigol_runstop_press, sizeof(w)) ||
+			    !memcmp(w, rigol_runstop_release, sizeof(w)))
+				return true;
+		}
+		if (get_timer(start) >= CONFIG_RIGOL_RUNSTOP_WINDOW_MS)
+			return false;
+		udelay(50);
+	}
+}
+
+/* One frame to the front-panel controller: exactly its five bytes. */
+static void rigol_mcu_send(const u8 *frame, int len)
+{
+	void __iomem *uart = (void __iomem *)RIGOL_UART0_BASE;
+	ulong start = get_timer(0);
+	int i;
+
+	for (i = 0; i < len; i++) {
+		while (!(readl(uart + UART_LSR) & UART_LSR_THRE))
+			if (get_timer(start) > 10)
+				return;
+		writel(frame[i], uart + UART_THR);
+	}
+	while (!(readl(uart + UART_LSR) & UART_LSR_TEMT))
+		if (get_timer(start) > 10)
+			return;
+}
+
+/* No download key: never reset into Maskrom from U-Boot (boot_mode.c). */
+int rockchip_dnl_key_pressed(void)
+{
+	return 0;
+}
+
+/* From misc_init_r(), before board_late_init()'s setup_boot_mode() writes BOOT_NORMAL. */
+int rockchip_early_misc_init_r(void)
+{
+	u32 flag = readl(RK3399_PMUGRF_OS_REG0);
+	enum rigol_bootmode mode = rigol_decode_reboot_flag(flag);
+
+	printf("rigol: reboot flag 0x%08x: %s\n", flag, rigol_bootmode_name(mode));
+	env_set_hex("rigol_reboot_flag", flag);
+	env_set("rigol_bootmode", rigol_bootmode_name(mode));
+	env_set("rigol_bootreason", mode == RIGOL_BOOT_NORMAL ? "normal" : "reboot-flag");
+
+	return 0;
+}
+
+/* The end of board_late_init(): the reboot flag first, then Run/Stop, then the frame. */
+int rk_board_late_init(void)
+{
+	const char *mode = env_get("rigol_bootmode");
+
+	if (!mode || strcmp(mode, "normal"))
+		return 0;
+
+	if (!rigol_uart0_is_open())
+		rigol_uart0_open();
+
+	if (rigol_runstop_seen()) {
+		printf("rigol: Run/Stop at power-on: Loader mode\n");
+		env_set("rigol_bootmode", "loader");
+		env_set("rigol_bootreason", "runstop");
+		return 0;
+	}
+
+	/*
+	 * Auto: the manual setting is vendor-storage item 0x11, which is not
+	 * read here (the units seen carry none).
+	 */
+	rigol_mcu_send(rigol_power_mode_auto, sizeof(rigol_power_mode_auto));
+
+	return 0;
+}
+
+#endif /* CONFIG_XPL_BUILD */
