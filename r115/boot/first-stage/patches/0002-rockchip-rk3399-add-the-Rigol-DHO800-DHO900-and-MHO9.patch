diff --git a/arch/arm/dts/rk3399-rigol-u-boot.dtsi b/arch/arm/dts/rk3399-rigol-u-boot.dtsi
new file mode 100644
index 00000000..e7e0ac76
--- /dev/null
+++ b/arch/arm/dts/rk3399-rigol-u-boot.dtsi
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Rigol DHO800/DHO900 and MHO900: U-Boot-only properties.
+ *
+ * Copyright (C) 2026 Olympian LED, Inc.
+ */
+
+#include "rk3399-u-boot.dtsi"
+/*
+ * LPDDR4, 2 channels x 32 bit, 1 rank, 4 GiB: PMUGRF OS_REG2 reads 0x32C1F2C1
+ * on these boards. This is the only LPDDR4 timing set
+ * in U-Boot; the driver trains at 400 MHz, runs at 800 MHz and detects rank,
+ * column, bank and row itself (drivers/ram/rockchip/sdram_rk3399.c sdram_init).
+ */
+#include "rk3399-sdram-lpddr4-100.dtsi"
+
+/ {
+	/* rk3399-u-boot.dtsi names the (absent) eMMC mmc0: the card is the only MMC here. */
+	aliases {
+		mmc0 = &sdmmc;
+		/delete-property/ mmc1;
+	};
+
+	chosen {
+		u-boot,spl-boot-order = "same-as-spl", &sdmmc;
+	};
+};
+
+&uart2 {
+	bootph-all;
+};
diff --git a/arch/arm/dts/rk3399-rigol.dtsi b/arch/arm/dts/rk3399-rigol.dtsi
new file mode 100644
index 00000000..02628b11
--- /dev/null
+++ b/arch/arm/dts/rk3399-rigol.dtsi
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Rigol DHO800/DHO900 and MHO900 oscilloscopes (Rockchip RK3399): what the
+ * boot loader itself uses, nothing more. The kernel gets its own device tree
+ * from the boot image; this one is U-Boot's control DT only.
+ *
+ * Copyright (C) 2026 Olympian LED, Inc.
+ *
+ * The console (UART2 at 115200), the SD card on SDMMC0 (no eMMC is fitted)
+ * and OTG0 are as the NovaOS kernel's device trees for these boards have
+ * them; no pin that one of the two families must never have driven is
+ * named here. The front-panel UART0 is driven by board/rigol/rigol_rk3399
+ * through its
+ * registers, not by a driver, so its node stays disabled here.
+ */
+
+#include "rk3399.dtsi"
+
+/ {
+	aliases {
+		mmc0 = &sdmmc;
+	};
+
+	chosen {
+		stdout-path = "serial2:115200n8";
+	};
+};
+
+/* The console: UART2 channel C (GPIO4_C3/C4), 115200 8N1 in every stage. */
+&uart2 {
+	status = "okay";
+};
+
+/* The boot medium: an SD card on SDMMC0, 4-bit, SD high speed; no eMMC is fitted. */
+&sdmmc {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	disable-wp;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_cd &sdmmc_bus4>;
+	status = "okay";
+};
+
+&sdhci {
+	status = "disabled";
+};
+
+&emmc_phy {
+	status = "disabled";
+};
+
+/* Loader mode (Rockusb) on OTG0, the rear USB DEVICE connector, high speed only. */
+&u2phy0 {
+	status = "okay";
+};
+
+&u2phy0_otg {
+	status = "okay";
+};
+
+&usbdrd3_0 {
+	status = "okay";
+};
+
+&usbdrd_dwc3_0 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	phys = <&u2phy0_otg>;
+	phy-names = "usb2-phy";
+	status = "okay";
+};
